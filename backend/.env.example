# Firebase Service Account (Admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# For Cloud Run: store the service account JSON in a secret manager instead,
# then inject it as this env var (leave FIREBASE_SERVICE_ACCOUNT_PATH unset):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Cloud Project
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-gcs-bucket-name
GCP_LOCATION=us-central1

# Firestore Database
FIRESTORE_DATABASE_ID=(default)

# Vertex AI Configuration
VERTEX_AI_MODEL=gemini-3.5-flash

# Process role: "api" (default, serves the public HTTP routes), "worker"
# (serves only the internal job-execution route), or "combined" (both, for
# ephemeral single-service preview deployments).
SERVICE_MODE=api

# Cloud Tasks queue + worker dispatch config (required for POST /jobs
# to enqueue work)
CLOUD_TASKS_QUEUE=projects/your-gcp-project-id/locations/us-central1/queues/your-queue-name
WORKER_URL=https://your-worker-service.example
WORKER_SERVICE_ACCOUNT=your-worker-sa@your-gcp-project-id.iam.gserviceaccount.com

# Set to "false" to skip verifying Cloud Tasks' OIDC token on the worker
# route (local/dev only -- verification is ON by default and should stay on
# in any real deployment).
WORKER_VERIFY_OIDC=true

# Per-IP rate-limit hashing salt (required in production -- an unset salt
# falls back to a process-local random value, logged as an error).
RATE_LIMIT_SALT=

# Number of trusted reverse-proxy hops between the public internet and this
# container. Default (1) matches a direct Cloud Run deployment; only change
# this if you put another proxy/load balancer in front of it.
TRUSTED_PROXY_HOPS=1

# Anonymous-account cleanup job (scripts/cleanup_anonymous_users.py). Set to
# "false" to actually delete matching accounts; defaults to a dry run.
RETENTION_DRY_RUN=true
